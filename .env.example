# OpenAI API Key (used for both Whisper transcription and GPT summarization)
OPENAI_API_KEY=sk-your-key-here

# Google Drive OAuth (optional - configure in app.json for EAS builds)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft OneDrive OAuth (optional - configure in app.json for EAS builds)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
